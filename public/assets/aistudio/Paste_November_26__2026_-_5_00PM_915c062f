<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Quản lý thuê máy ảnh</title>
  <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.19/index.global.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/@fullcalendar/core@6.1.19/locales-all.global.min.js"></script>
  <style>
    :root{--bg:#f4f8ff;--panel:#fff;--text:#10213a;--muted:#6b7c93;--line:#dce8f7;--primary:#0068ff;--primary2:#00a3ff;--good:#0f9f6e;--bad:#dc3545;--warn:#f59e0b;--blue:#0068ff;--shadow:0 16px 40px rgba(0,104,255,.10);--soft-blue:#eef6ff;--gradient:linear-gradient(135deg,#0068ff 0%,#008cff 52%,#00b2ff 100%)}
    *{box-sizing:border-box} body{margin:0;font-family:Inter,ui-sans-serif,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;background:var(--bg);color:var(--text)}
    button,input,select,textarea{font:inherit} button{cursor:pointer}
    .app{display:grid;grid-template-columns:248px minmax(0,1fr);min-height:100vh}
    .sidebar{background:linear-gradient(180deg,#0068ff 0%,#007dff 48%,#00a8f3 100%);color:#fff;padding:22px 16px;position:sticky;top:0;height:100vh;box-shadow:10px 0 32px rgba(0,104,255,.12)}
    .brand{font-size:19px;font-weight:850;letter-spacing:-.025em;margin:4px 8px 22px}.brand small{display:block;font-size:11px;color:rgba(255,255,255,.72);font-weight:650;margin-top:5px}
    .nav{display:grid;gap:6px}.nav button{border:0;background:transparent;color:rgba(255,255,255,.82);text-align:left;padding:11px 12px;border-radius:12px;font-weight:700;transition:.18s ease}.nav button:hover,.nav button.active{background:rgba(255,255,255,.18);color:#fff;box-shadow:inset 0 0 0 1px rgba(255,255,255,.08)}.nav .sep{height:1px;background:rgba(255,255,255,.20);margin:8px 0}
    .main{min-width:0;padding:24px 28px 48px}.top{display:flex;justify-content:space-between;gap:16px;align-items:center;margin-bottom:22px}.top h1{margin:0;font-size:26px;letter-spacing:-.03em}.top p{margin:5px 0 0;color:var(--muted);font-size:13px}.actions{display:flex;gap:9px;flex-wrap:wrap}
    .btn{border:1px solid var(--line);background:#fff;padding:10px 14px;border-radius:12px;font-weight:750;color:var(--text);transition:.18s ease;box-shadow:0 2px 8px rgba(0,104,255,.03)}.btn:hover{transform:translateY(-1px);box-shadow:0 8px 18px rgba(0,104,255,.10)}.btn.primary{background:var(--gradient);color:#fff;border-color:transparent;box-shadow:0 8px 20px rgba(0,104,255,.22)}.btn.good{background:#166534;color:#fff;border-color:#166534}.btn.danger{background:#991b1b;color:#fff;border-color:#991b1b}.btn.small{padding:7px 10px;font-size:12px}
    .grid4{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;margin-bottom:18px}.stat{background:linear-gradient(180deg,#fff 0%,#fbfdff 100%);border:1px solid var(--line);border-radius:18px;padding:17px;box-shadow:0 8px 24px rgba(0,104,255,.06)}.stat .label{font-size:12px;color:var(--muted);font-weight:700}.stat .value{font-size:28px;font-weight:800;margin-top:8px}.stat .hint{font-size:11px;color:var(--muted);margin-top:3px}
    .panel{background:var(--panel);border:1px solid var(--line);border-radius:18px;padding:17px;box-shadow:0 8px 26px rgba(0,104,255,.055)}.panel h3{margin:0 0 13px;font-size:16px}.split{display:grid;grid-template-columns:minmax(0,1.65fr) minmax(300px,.75fr);gap:16px}
    #calendar{min-height:680px}.fc .fc-toolbar-title{font-size:18px}.fc .fc-button{background:var(--gradient);border-color:transparent;border-radius:9px;box-shadow:none}.fc .fc-button:hover{filter:brightness(.98)}.fc .fc-button-primary:not(:disabled).fc-button-active{background:#005be0}.fc .fc-daygrid-day.fc-day-today{background:#eef7ff}.fc .fc-col-header-cell-cushion,.fc .fc-daygrid-day-number{color:#35516f;text-decoration:none}.fc-event{cursor:pointer}
    .upcoming{display:grid;gap:9px}.rent-card{border:1px solid var(--line);border-radius:12px;padding:12px;display:grid;gap:5px}.rent-card .title{font-weight:800;font-size:14px}.rent-card .meta{font-size:12px;color:var(--muted)}
    .badge{display:inline-flex;width:max-content;align-items:center;border-radius:999px;padding:4px 8px;font-size:10px;font-weight:800;background:#f3f4f6;color:#374151}.badge.good{background:#dcfce7;color:#166534}.badge.warn{background:#fef3c7;color:#92400e}.badge.bad{background:#fee2e2;color:#991b1b}.badge.blue{background:#e7f2ff;color:#0068ff}
    .page{display:none}.page.active{display:block}.machine-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:15px}.machine{overflow:hidden;background:#fff;border:1px solid var(--line);border-radius:16px}.machine-img{height:165px;background:#e5e7eb;display:flex;align-items:center;justify-content:center;color:#64748b;font-size:12px}.machine-img img{width:100%;height:100%;object-fit:cover}.machine-body{padding:14px}.machine-name{font-size:17px;font-weight:800}.machine-meta{font-size:12px;color:var(--muted);margin:5px 0 12px}.machine-prices{display:grid;grid-template-columns:repeat(3,1fr);gap:6px}.price-box{background:var(--soft-blue);border-radius:10px;padding:8px}.price-box b{display:block;font-size:12px}.price-box span{font-size:10px;color:var(--muted)}
    .form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.field{display:grid;gap:6px}.field.full{grid-column:1/-1}.field label{font-size:12px;font-weight:800;color:#374151}.field input,.field select,.field textarea{width:100%;border:1px solid #d1d5db;border-radius:10px;padding:10px 11px;background:#fff;outline:none}.field input:focus,.field select:focus,.field textarea:focus{border-color:#6fb4ff;box-shadow:0 0 0 3px rgba(0,104,255,.12)}.check{display:flex;gap:8px;align-items:center;font-size:13px}.check input{width:auto}.row{display:flex;gap:9px;align-items:center;flex-wrap:wrap}
    .availability{margin-top:14px;border-radius:14px;padding:15px;border:1px dashed #b9d9ff;background:#f5faff}.availability.good{border-color:#86efac;background:#f0fdf4}.availability.bad{border-color:#fca5a5;background:#fef2f2}.conflicts{display:grid;gap:7px;margin-top:10px}.conflict{background:#fff;border:1px solid var(--line);border-radius:9px;padding:9px;font-size:12px}
    .message-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.message-card{border:1px solid var(--line);border-radius:14px;padding:14px;background:#fff}.message-card h4{margin:0 0 5px}.message-card .meta{font-size:12px;color:var(--muted);margin-bottom:10px}.msg{background:#f5faff;border:1px solid var(--line);border-radius:10px;padding:11px;white-space:pre-wrap;font-size:13px;line-height:1.55;margin-bottom:8px}
    .modal-backdrop{position:fixed;inset:0;background:rgba(15,23,42,.58);z-index:50;display:none;align-items:center;justify-content:center;padding:18px}.modal-backdrop.show{display:flex}.modal{width:min(760px,100%);max-height:92vh;overflow:auto;background:#fff;border-radius:18px;box-shadow:var(--shadow)}.modal-head{padding:17px 18px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:center}.modal-head h3{margin:0}.modal-body{padding:18px}.modal-foot{padding:14px 18px;border-top:1px solid var(--line);display:flex;justify-content:flex-end;gap:8px}.close{border:0;background:#f3f4f6;width:34px;height:34px;border-radius:9px;font-size:18px}
    .toast{position:fixed;right:20px;bottom:20px;z-index:100;background:var(--gradient);color:#fff;padding:11px 14px;border-radius:10px;box-shadow:var(--shadow);display:none;max-width:360px}.toast.show{display:block}.loading{position:fixed;inset:0;z-index:200;background:rgba(255,255,255,.72);display:none;align-items:center;justify-content:center;font-weight:800}.loading.show{display:flex}
    .detail-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}.detail-box{border:1px solid var(--line);border-radius:10px;padding:10px}.detail-box span{display:block;font-size:10px;color:var(--muted);font-weight:800;text-transform:uppercase}.detail-box b{display:block;margin-top:4px;font-size:13px}.detail-actions{display:flex;gap:8px;flex-wrap:wrap;margin:14px 0}.detail-msg{margin-top:14px}.empty{padding:24px;text-align:center;color:var(--muted);font-size:13px;border:1px dashed var(--line);border-radius:12px}
    @media(max-width:1050px){.grid4{grid-template-columns:repeat(2,1fr)}.split{grid-template-columns:1fr}.machine-grid{grid-template-columns:repeat(2,1fr)}}
    @media(max-width:760px){.app{grid-template-columns:1fr}.sidebar{position:relative;height:auto;padding:10px}.brand{margin:4px 6px 10px}.nav{grid-template-columns:repeat(4,1fr)}.nav .sep{display:none}.nav button{font-size:11px;text-align:center;padding:9px 5px}.main{padding:16px}.top{align-items:flex-start;flex-direction:column}.grid4,.machine-grid,.message-list,.form-grid,.detail-grid{grid-template-columns:1fr}.field.full{grid-column:auto}#calendar{min-height:560px}.fc .fc-toolbar{flex-direction:column;gap:7px}}
  </style>
</head>
<body>
<div class="loading" id="loading">Đang xử lý...</div>
<div class="toast" id="toast"></div>
<div class="app">
  <aside class="sidebar">
    <div class="brand">Quản lý thuê máy ảnh <small>Lịch thuê • Cọc • Thiết bị</small></div>
    <div class="nav">
      <button class="active" data-page="dashboard">▦ Tổng quan</button>
      <button data-page="machines">▣ Máy ảnh</button>
      <button data-page="check">✓ Check lịch</button>
      <button data-page="messages">✦ Tin nhắn</button>
      <div class="sep"></div>
      <button onclick="openRentalModal()">＋ Thêm lịch thuê</button>
      <button onclick="openMachineModal()">＋ Thêm máy ảnh</button>
    </div>
  </aside>

  <main class="main">
    <section class="page active" id="page-dashboard">
      <div class="top"><div><h1>Lịch cho thuê</h1><p>Xem nhanh máy đang thuê, lịch sắp tới và tình trạng cọc.</p></div><div class="actions"><button class="btn" onclick="refreshAll()">Làm mới</button><button class="btn primary" onclick="openRentalModal()">+ Thêm lịch thuê</button></div></div>
      <div class="grid4" id="stats"></div>
      <div class="split"><div class="panel"><div id="calendar"></div></div><div class="panel"><h3>Lịch sắp tới</h3><div class="upcoming" id="upcoming"></div></div></div>
    </section>

    <section class="page" id="page-machines">
      <div class="top"><div><h1>Máy ảnh</h1><p>Thêm máy, hình ảnh, giá tham khảo, cọc và trạng thái.</p></div><button class="btn primary" onclick="openMachineModal()">+ Thêm máy ảnh</button></div>
      <div class="machine-grid" id="machineGrid"></div>
    </section>

    <section class="page" id="page-check">
      <div class="top"><div><h1>Check lịch thuê</h1><p>Chọn máy và khoảng thời gian để biết còn trống hay đã có khách.</p></div></div>
      <div class="panel" style="max-width:820px">
        <div class="form-grid">
          <div class="field full"><label>Máy ảnh</label><select id="checkMachine"></select></div>
          <div class="field"><label>Nhận máy</label><input type="datetime-local" id="checkStart"></div>
          <div class="field"><label>Trả máy</label><input type="datetime-local" id="checkEnd"></div>
          <div class="field full"><div class="row"><button class="btn primary" onclick="runAvailabilityCheck()">Check lịch</button><button class="btn" onclick="useCheckForRental()">Dùng thời gian này để tạo lịch</button></div></div>
        </div>
        <div class="availability" id="availabilityBox">Chưa kiểm tra lịch.</div>
      </div>
    </section>

    <section class="page" id="page-messages">
      <div class="top"><div><h1>Tin nhắn tự động</h1><p>Chọn lịch thuê và copy nhanh tin xác nhận cọc, nhắc nhận máy, nhắc trả máy...</p></div></div>
      <div class="message-list" id="messageList"></div>
    </section>
  </main>
</div>

<div class="modal-backdrop" id="machineModal">
  <div class="modal">
    <div class="modal-head"><h3 id="machineModalTitle">Thêm máy ảnh</h3><button class="close" onclick="closeModal('machineModal')">×</button></div>
    <div class="modal-body">
      <form id="machineForm" class="form-grid" onsubmit="event.preventDefault();submitMachine();">
        <input type="hidden" id="mId">
        <div class="field full"><label>Tên máy *</label><input id="mName" placeholder="Ví dụ: Canon R50" required></div>
        <div class="field"><label>Loại</label><input id="mType" value="Máy ảnh"></div>
        <div class="field"><label>Serial</label><input id="mSerial" placeholder="Số serial nếu cần"></div>
        <div class="field full"><label>Hình ảnh</label><input type="file" id="mImageFile" accept="image/*"><input id="mImageUrl" type="hidden"><div id="mImagePreview" style="margin-top:8px"></div></div>
        <div class="field"><label>Giá 6 giờ</label><input type="number" id="m6h" min="0" step="1000"></div>
        <div class="field"><label>Giá 1 ngày</label><input type="number" id="m1d" min="0" step="1000"></div>
        <div class="field"><label>Giá 2 ngày</label><input type="number" id="m2d" min="0" step="1000"></div>
        <div class="field"><label>Cọc thế chân mặc định</label><input type="number" id="mCollateral" min="0" step="1000" value="2000000"></div>
        <div class="field"><label>Trạng thái</label><select id="mStatus"><option value="HOAT_DONG">Hoạt động</option><option value="BAO_TRI">Bảo trì</option><option value="NGUNG_CHO_THUE">Ngừng cho thuê</option></select></div>
        <div class="field"><label class="check"><input type="checkbox" id="mHoldId" checked> Mặc định giữ CCCD</label></div>
        <div class="field full"><label>Ghi chú</label><textarea id="mNote" rows="3"></textarea></div>
      </form>
    </div>
    <div class="modal-foot"><button class="btn" onclick="closeModal('machineModal')">Hủy</button><button class="btn primary" onclick="submitMachine()">Lưu máy</button></div>
  </div>
</div>

<div class="modal-backdrop" id="rentalModal">
  <div class="modal">
    <div class="modal-head"><h3 id="rentalModalTitle">Thêm lịch thuê</h3><button class="close" onclick="closeModal('rentalModal')">×</button></div>
    <div class="modal-body">
      <form id="rentalForm" class="form-grid" onsubmit="event.preventDefault();submitRental();">
        <input type="hidden" id="rId">
        <div class="field full"><label>Máy ảnh *</label><select id="rMachine" required></select></div>
        <div class="field"><label>Tên khách *</label><input id="rCustomer" required></div>
        <div class="field"><label>Số điện thoại</label><input id="rPhone"></div>
        <div class="field"><label>Nhận máy *</label><input type="datetime-local" id="rStart" required></div>
        <div class="field"><label>Trả máy *</label><input type="datetime-local" id="rEnd" required></div>
        <div class="field"><label>Giá thuê</label><input type="number" id="rPrice" min="0" step="1000"></div>
        <div class="field"><label>Cọc giữ lịch</label><input type="number" id="rBookingDeposit" min="0" step="1000"></div>
        <div class="field"><label class="check"><input type="checkbox" id="rBookingPaid"> Đã nhận cọc giữ lịch</label></div>
        <div class="field"><label>Cọc thế chân</label><input type="number" id="rCollateral" min="0" step="1000"></div>
        <div class="field"><label class="check"><input type="checkbox" id="rCollateralPaid"> Đã nhận cọc thế chân</label></div>
        <div class="field"><label class="check"><input type="checkbox" id="rHoldId" checked> Giữ CCCD</label></div>
        <div class="field"><label class="check"><input type="checkbox" id="rIdReceived"> Đã nhận CCCD</label></div>
        <div class="field"><label>Phụ phí</label><input type="number" id="rExtra" min="0" step="1000"></div>
        <div class="field"><label class="check"><input type="checkbox" id="rPaid"> Đã thanh toán tiền thuê</label></div>
        <div class="field"><label>Trạng thái</label><select id="rStatus"><option value="GIU_LICH">Giữ lịch</option><option value="DA_GIAO_MAY">Đã giao máy</option><option value="DA_TRA">Đã trả</option><option value="HUY">Hủy</option></select></div>
        <div class="field full"><label>Ghi chú</label><textarea id="rNote" rows="3"></textarea></div>
        <div class="field full"><div class="row"><button type="button" class="btn" onclick="checkRentalFormAvailability()">Check trùng lịch</button><span id="rCheckResult" style="font-size:12px;color:#6b7280"></span></div></div>
      </form>
    </div>
    <div class="modal-foot"><button class="btn" onclick="closeModal('rentalModal')">Hủy</button><button class="btn primary" onclick="submitRental()">Lưu lịch thuê</button></div>
  </div>
</div>

<div class="modal-backdrop" id="detailModal">
  <div class="modal">
    <div class="modal-head"><h3>Chi tiết lịch thuê</h3><button class="close" onclick="closeModal('detailModal')">×</button></div>
    <div class="modal-body" id="detailBody"></div>
    <div class="modal-foot"><button class="btn" onclick="closeModal('detailModal')">Đóng</button><button class="btn primary" id="detailEditBtn">Chỉnh sửa</button></div>
  </div>
</div>

<script>
let STATE={machines:[],rentals:[],settings:{},dashboard:{}};
let calendar=null;
let CURRENT_DETAIL=null;
const $=id=>document.getElementById(id);
const money=n=>(Number(n)||0).toLocaleString('vi-VN')+'đ';
const dt=s=>s?new Date(s):null;
const fmt=s=>{const d=dt(s);return d?d.toLocaleString('vi-VN',{hour:'2-digit',minute:'2-digit',day:'2-digit',month:'2-digit',year:'numeric'}):''};
const statusLabel=s=>({GIU_LICH:'Giữ lịch',DA_GIAO_MAY:'Đã giao máy',DA_TRA:'Đã trả',HUY:'Hủy',HOAT_DONG:'Hoạt động',BAO_TRI:'Bảo trì',NGUNG_CHO_THUE:'Ngừng cho thuê'}[s]||s||'');
const statusBadge=s=>s==='DA_TRA'||s==='HOAT_DONG'?'good':s==='HUY'||s==='NGUNG_CHO_THUE'?'bad':s==='DA_GIAO_MAY'?'blue':'warn';

function callGas(fn,args=[]){return new Promise((resolve,reject)=>{google.script.run.withSuccessHandler(resolve).withFailureHandler(err=>reject(new Error(err.message||String(err))))[fn](...args);});}
function setLoading(v){$('loading').classList.toggle('show',!!v)}
function toast(msg){$('toast').textContent=msg;$('toast').classList.add('show');setTimeout(()=>$('toast').classList.remove('show'),2600)}
function openModal(id){$(id).classList.add('show')}
function closeModal(id){$(id).classList.remove('show')}
function setPage(name){document.querySelectorAll('.page').forEach(x=>x.classList.remove('active'));document.querySelectorAll('.nav button[data-page]').forEach(x=>x.classList.toggle('active',x.dataset.page===name));$('page-'+name).classList.add('active');if(name==='dashboard'&&calendar)setTimeout(()=>calendar.updateSize(),50)}

document.querySelectorAll('.nav button[data-page]').forEach(b=>b.addEventListener('click',()=>setPage(b.dataset.page)));
document.querySelectorAll('.modal-backdrop').forEach(m=>m.addEventListener('click',e=>{if(e.target===m)closeModal(m.id)}));

async function init(){setLoading(true);try{STATE=await callGas('getInitialData');renderAll();}catch(e){alert('Chưa khởi tạo dữ liệu. Hãy chạy setupProject() một lần trong Apps Script.\n\n'+e.message)}finally{setLoading(false)}}
async function refreshAll(){setLoading(true);try{STATE=await callGas('getInitialData');renderAll();toast('Đã làm mới dữ liệu');}catch(e){alert(e.message)}finally{setLoading(false)}}
function renderAll(){renderStats();renderMachines();fillMachineSelects();renderCalendar();renderUpcoming();renderMessages()}

function renderStats(){const d=STATE.dashboard||{};$('stats').innerHTML=`
<div class="stat"><div class="label">Máy đang hoạt động</div><div class="value">${d.totalMachines||0}</div><div class="hint">Sẵn sàng quản lý lịch thuê</div></div>
<div class="stat"><div class="label">Đang có khách thuê</div><div class="value">${d.rentingNow||0}</div><div class="hint">Tại thời điểm hiện tại</div></div>
<div class="stat"><div class="label">Lịch nhận máy hôm nay</div><div class="value">${d.todayBookings||0}</div><div class="hint">Không tính lịch đã hủy</div></div>
<div class="stat"><div class="label">Cọc giữ lịch chưa nhận</div><div class="value">${d.unpaidBookingDeposits||0}</div><div class="hint">Cần theo dõi/xác nhận</div></div>`}

function renderMachines(){const el=$('machineGrid');if(!STATE.machines.length){el.innerHTML='<div class="empty">Chưa có máy ảnh. Bấm “Thêm máy ảnh” để bắt đầu.</div>';return}el.innerHTML=STATE.machines.map(m=>`
<div class="machine"><div class="machine-img">${m.hinhAnh?`<img src="${escapeHtml(m.hinhAnh)}" alt="${escapeHtml(m.tenMay)}">`:'Chưa có hình ảnh'}</div><div class="machine-body">
<div class="row" style="justify-content:space-between"><div class="machine-name">${escapeHtml(m.tenMay)}</div><span class="badge ${statusBadge(m.trangThai)}">${statusLabel(m.trangThai)}</span></div>
<div class="machine-meta">${escapeHtml(m.loai||'Máy ảnh')}${m.serial?' • Serial: '+escapeHtml(m.serial):''}</div>
<div class="machine-prices"><div class="price-box"><span>6 giờ</span><b>${money(m.gia6h)}</b></div><div class="price-box"><span>1 ngày</span><b>${money(m.gia1Ngay)}</b></div><div class="price-box"><span>2 ngày</span><b>${money(m.gia2Ngay)}</b></div></div>
<div class="row" style="margin-top:12px"><button class="btn small" onclick="editMachine('${m.id}')">Sửa</button><button class="btn small" onclick="prefillCheck('${m.id}')">Check lịch</button></div>
</div></div>`).join('')}

function fillMachineSelects(){const html='<option value="">-- Chọn máy --</option>'+STATE.machines.filter(m=>m.trangThai!=='NGUNG_CHO_THUE').map(m=>`<option value="${m.id}">${escapeHtml(m.tenMay)}</option>`).join('');['checkMachine','rMachine'].forEach(id=>{const old=$(id).value;$(id).innerHTML=html;if([...$(id).options].some(o=>o.value===old))$(id).value=old})}

function renderCalendar(){const events=STATE.rentals.filter(r=>r.trangThai!=='HUY').map(r=>({id:r.id,title:`${r.tenMay||r.maMay} • ${r.tenKhach}`,start:r.startAt,end:r.endAt,backgroundColor:r.trangThai==='DA_GIAO_MAY'?'#2563eb':r.trangThai==='DA_TRA'?'#16a34a':'#111827',borderColor:'transparent'}));if(calendar){calendar.removeAllEvents();calendar.addEventSource(events);return}calendar=new FullCalendar.Calendar($('calendar'),{locale:'vi',initialView:'dayGridMonth',height:'auto',nowIndicator:true,headerToolbar:{left:'prev,next today',center:'title',right:'dayGridMonth,timeGridWeek,timeGridDay,listWeek'},buttonText:{today:'Hôm nay',month:'Tháng',week:'Tuần',day:'Ngày',list:'Danh sách'},events,eventClick:info=>openRentalDetail(info.event.id),dateClick:info=>{if(info.allDay){openRentalModal({startAt:info.dateStr+'T09:00',endAt:info.dateStr+'T15:00'})}else{const st=new Date(info.date);const en=new Date(st.getTime()+6*3600000);openRentalModal({startAt:toLocalInput(st),endAt:toLocalInput(en)})}}});calendar.render()}

function renderUpcoming(){const arr=(STATE.dashboard&&STATE.dashboard.upcoming)||[];const el=$('upcoming');if(!arr.length){el.innerHTML='<div class="empty">Chưa có lịch sắp tới.</div>';return}el.innerHTML=arr.map(r=>`<div class="rent-card" onclick="openRentalDetail('${r.id}')"><div class="row" style="justify-content:space-between"><div class="title">${escapeHtml(r.tenMay)} • ${escapeHtml(r.tenKhach)}</div><span class="badge ${statusBadge(r.trangThai)}">${statusLabel(r.trangThai)}</span></div><div class="meta">${fmt(r.startAt)} → ${fmt(r.endAt)}</div><div class="meta">Cọc giữ lịch: ${money(r.cocGiuLich)} ${r.daNhanCocGiuLich?'✓ đã nhận':'• chưa nhận'}</div></div>`).join('')}

function renderMessages(){const arr=STATE.rentals.filter(r=>r.trangThai!=='HUY').sort((a,b)=>dt(b.startAt)-dt(a.startAt)).slice(0,20);const el=$('messageList');if(!arr.length){el.innerHTML='<div class="empty">Chưa có lịch thuê để tạo tin nhắn.</div>';return}el.innerHTML=arr.map(r=>`<div class="message-card"><h4>${escapeHtml(r.tenMay)} • ${escapeHtml(r.tenKhach)}</h4><div class="meta">${fmt(r.startAt)} → ${fmt(r.endAt)}</div><div class="row"><button class="btn small" onclick="copyRentalMessage('${r.id}','depositReceived')">Copy xác nhận cọc</button><button class="btn small" onclick="copyRentalMessage('${r.id}','pickupReminder')">Copy nhắc nhận máy</button><button class="btn small" onclick="copyRentalMessage('${r.id}','returnReminder')">Copy nhắc trả máy</button><button class="btn small" onclick="openRentalDetail('${r.id}')">Xem đủ</button></div></div>`).join('')}

function openMachineModal(data){$('machineForm').reset();$('mId').value='';$('mType').value='Máy ảnh';$('mCollateral').value=2000000;$('mHoldId').checked=true;$('mImageUrl').value='';$('mImagePreview').innerHTML='';$('machineModalTitle').textContent='Thêm máy ảnh';if(data)fillMachineForm(data);openModal('machineModal')}
function editMachine(id){const m=STATE.machines.find(x=>x.id===id);if(m)openMachineModal(m)}
function fillMachineForm(m){$('machineModalTitle').textContent='Chỉnh sửa máy ảnh';$('mId').value=m.id||'';$('mName').value=m.tenMay||'';$('mType').value=m.loai||'';$('mSerial').value=m.serial||'';$('mImageUrl').value=m.hinhAnh||'';$('m6h').value=m.gia6h||'';$('m1d').value=m.gia1Ngay||'';$('m2d').value=m.gia2Ngay||'';$('mCollateral').value=m.cocTheChanMacDinh||'';$('mStatus').value=m.trangThai||'HOAT_DONG';$('mHoldId').checked=!!m.giuCCCDMacDinh;$('mNote').value=m.ghiChu||'';$('mImagePreview').innerHTML=m.hinhAnh?`<img src="${m.hinhAnh}" style="width:160px;height:100px;object-fit:cover;border-radius:10px;border:1px solid #e5e7eb">`:''}
async function submitMachine(){if(!$('mName').value.trim())return toast('Vui lòng nhập tên máy');setLoading(true);try{let imageUrl=$('mImageUrl').value;const file=$('mImageFile').files[0];if(file){if(file.size>5*1024*1024)throw new Error('Ảnh nên nhỏ hơn 5MB.');const dataUrl=await readFileAsDataURL(file);const up=await callGas('uploadMachineImage',[dataUrl,file.name]);imageUrl=up.url}const payload={id:$('mId').value,tenMay:$('mName').value,loai:$('mType').value,serial:$('mSerial').value,hinhAnh:imageUrl,trangThai:$('mStatus').value,gia6h:$('m6h').value,gia1Ngay:$('m1d').value,gia2Ngay:$('m2d').value,cocTheChanMacDinh:$('mCollateral').value,giuCCCDMacDinh:$('mHoldId').checked,ghiChu:$('mNote').value};await callGas('saveMachine',[payload]);closeModal('machineModal');await refreshAll();toast('Đã lưu máy ảnh');}catch(e){alert(e.message)}finally{setLoading(false)}}
function readFileAsDataURL(file){return new Promise((res,rej)=>{const r=new FileReader();r.onload=()=>res(r.result);r.onerror=rej;r.readAsDataURL(file)})}

function openRentalModal(prefill){$('rentalForm').reset();$('rId').value='';$('rHoldId').checked=true;$('rStatus').value='GIU_LICH';$('rCheckResult').textContent='';$('rentalModalTitle').textContent='Thêm lịch thuê';if(prefill&&prefill.id)fillRentalForm(prefill);else if(prefill){if(prefill.machineId)$('rMachine').value=prefill.machineId;if(prefill.startAt)$('rStart').value=prefill.startAt.slice(0,16);if(prefill.endAt)$('rEnd').value=prefill.endAt.slice(0,16);applyMachineDefaults()}openModal('rentalModal')}
function fillRentalForm(r){$('rentalModalTitle').textContent='Chỉnh sửa lịch thuê';$('rId').value=r.id||'';$('rMachine').value=r.maMay||'';$('rCustomer').value=r.tenKhach||'';$('rPhone').value=r.soDienThoai||'';$('rStart').value=(r.startAt||'').slice(0,16);$('rEnd').value=(r.endAt||'').slice(0,16);$('rPrice').value=r.giaThue||'';$('rBookingDeposit').value=r.cocGiuLich||'';$('rBookingPaid').checked=!!r.daNhanCocGiuLich;$('rCollateral').value=r.cocTheChan||'';$('rCollateralPaid').checked=!!r.daNhanCocTheChan;$('rHoldId').checked=!!r.giuCCCD;$('rIdReceived').checked=!!r.daNhanCCCD;$('rExtra').value=r.phuPhi||'';$('rPaid').checked=!!r.daThanhToan;$('rStatus').value=r.trangThai||'GIU_LICH';$('rNote').value=r.ghiChu||''}
$('rMachine').addEventListener('change',applyMachineDefaults);
function applyMachineDefaults(){const m=STATE.machines.find(x=>x.id===$('rMachine').value);if(!m)return;if(!$('rCollateral').value)$('rCollateral').value=m.cocTheChanMacDinh||'';$('rHoldId').checked=!!m.giuCCCDMacDinh}
function rentalPayload(){return{id:$('rId').value,maMay:$('rMachine').value,tenKhach:$('rCustomer').value,soDienThoai:$('rPhone').value,startAt:$('rStart').value,endAt:$('rEnd').value,giaThue:$('rPrice').value,cocGiuLich:$('rBookingDeposit').value,daNhanCocGiuLich:$('rBookingPaid').checked,cocTheChan:$('rCollateral').value,daNhanCocTheChan:$('rCollateralPaid').checked,giuCCCD:$('rHoldId').checked,daNhanCCCD:$('rIdReceived').checked,phuPhi:$('rExtra').value,daThanhToan:$('rPaid').checked,trangThai:$('rStatus').value,ghiChu:$('rNote').value}}
async function checkRentalFormAvailability(){const p=rentalPayload();if(!p.maMay||!p.startAt||!p.endAt)return toast('Chọn máy và thời gian trước');try{const res=await callGas('checkAvailability',[p.maMay,p.startAt,p.endAt,p.id]);$('rCheckResult').innerHTML=res.available?'<span style="color:#15803d;font-weight:800">✓ Máy đang trống</span>':`<span style="color:#b91c1c;font-weight:800">✕ Trùng ${res.conflicts.length} lịch</span>`;return res}catch(e){$('rCheckResult').textContent=e.message}}
async function submitRental(){const p=rentalPayload();if(!p.maMay||!p.tenKhach||!p.startAt||!p.endAt)return toast('Vui lòng nhập đủ máy, khách, giờ nhận và giờ trả');setLoading(true);try{const res=await callGas('saveRental',[p]);closeModal('rentalModal');await refreshAll();toast('Đã lưu lịch thuê');if(res.rental&&res.rental.daNhanCocGiuLich){await openRentalDetail(res.rental.id)}}catch(e){alert(e.message)}finally{setLoading(false)}}

async function runAvailabilityCheck(){const machineId=$('checkMachine').value,start=$('checkStart').value,end=$('checkEnd').value;const box=$('availabilityBox');if(!machineId||!start||!end){box.className='availability';box.textContent='Vui lòng chọn đủ máy, giờ nhận và giờ trả.';return}setLoading(true);try{const res=await callGas('checkAvailability',[machineId,start,end,'']);box.className='availability '+(res.available?'good':'bad');if(res.available){box.innerHTML='<b style="color:#15803d">✓ Máy đang TRỐNG trong khoảng thời gian này.</b><div style="font-size:12px;margin-top:5px;color:#6b7280">Bạn có thể tạo lịch thuê ngay.</div>'}else{box.innerHTML=`<b style="color:#b91c1c">✕ Máy đã có ${res.conflicts.length} lịch bị trùng.</b><div class="conflicts">${res.conflicts.map(r=>`<div class="conflict"><b>${escapeHtml(r.tenKhach)}</b> • ${fmt(r.startAt)} → ${fmt(r.endAt)} • ${statusLabel(r.trangThai)}</div>`).join('')}</div>`}}catch(e){box.className='availability bad';box.textContent=e.message}finally{setLoading(false)}}
function useCheckForRental(){openRentalModal({machineId:$('checkMachine').value,startAt:$('checkStart').value,endAt:$('checkEnd').value})}
function prefillCheck(machineId){setPage('check');$('checkMachine').value=machineId;const now=new Date();now.setMinutes(Math.ceil(now.getMinutes()/30)*30,0,0);const end=new Date(now.getTime()+6*3600000);$('checkStart').value=toLocalInput(now);$('checkEnd').value=toLocalInput(end);runAvailabilityCheck()}
function toLocalInput(d){const p=n=>String(n).padStart(2,'0');return `${d.getFullYear()}-${p(d.getMonth()+1)}-${p(d.getDate())}T${p(d.getHours())}:${p(d.getMinutes())}`}

async function openRentalDetail(id){const r=STATE.rentals.find(x=>x.id===id);if(!r)return;CURRENT_DETAIL=r;setLoading(true);try{const msgs=await callGas('getRentalMessages',[id]);$('detailBody').innerHTML=`
<div class="row" style="justify-content:space-between;margin-bottom:12px"><div><div style="font-size:20px;font-weight:800">${escapeHtml(r.tenMay)} • ${escapeHtml(r.tenKhach)}</div><div style="font-size:12px;color:#6b7280;margin-top:4px">${escapeHtml(r.soDienThoai||'Không có SĐT')}</div></div><span class="badge ${statusBadge(r.trangThai)}">${statusLabel(r.trangThai)}</span></div>
<div class="detail-grid"><div class="detail-box"><span>Nhận máy</span><b>${fmt(r.startAt)}</b></div><div class="detail-box"><span>Trả máy</span><b>${fmt(r.endAt)}</b></div><div class="detail-box"><span>Giá thuê</span><b>${money(r.giaThue)}</b></div><div class="detail-box"><span>Cọc giữ lịch</span><b>${money(r.cocGiuLich)} • ${r.daNhanCocGiuLich?'Đã nhận':'Chưa nhận'}</b></div><div class="detail-box"><span>Cọc thế chân</span><b>${money(r.cocTheChan)} • ${r.daNhanCocTheChan?'Đã nhận':'Chưa nhận'}</b></div><div class="detail-box"><span>CCCD</span><b>${r.giuCCCD?(r.daNhanCCCD?'Đã nhận':'Cần giữ'):'Không giữ'}</b></div></div>
<div class="detail-actions"><button class="btn small" onclick="quickPatch('${r.id}','daNhanCocGiuLich',${!r.daNhanCocGiuLich})">${r.daNhanCocGiuLich?'Bỏ xác nhận cọc':'✓ Đã nhận cọc giữ lịch'}</button><button class="btn small" onclick="quickPatch('${r.id}','trangThai','DA_GIAO_MAY')">Đã giao máy</button><button class="btn small good" onclick="quickPatch('${r.id}','trangThai','DA_TRA')">Đã trả máy</button><button class="btn small danger" onclick="quickPatch('${r.id}','trangThai','HUY')">Hủy lịch</button></div>
<div class="detail-msg">${messageBlock('Xác nhận cọc',msgs.depositReceived,'depositReceived')}${messageBlock('Nhắc nhận máy',msgs.pickupReminder,'pickupReminder')}${messageBlock('Đã bàn giao máy',msgs.handedOver,'handedOver')}${messageBlock('Nhắc trả máy',msgs.returnReminder,'returnReminder')}${messageBlock('Hoàn tất',msgs.completed,'completed')}</div>`;$('detailEditBtn').onclick=()=>{closeModal('detailModal');openRentalModal(r)};openModal('detailModal')}catch(e){alert(e.message)}finally{setLoading(false)}}
function messageBlock(title,text,key){return `<div class="message-card" style="margin-bottom:10px"><h4>${title}</h4><div class="msg">${escapeHtml(text)}</div><button class="btn small" onclick="copyTextFromDetail('${key}')">Copy tin nhắn</button></div>`}
async function quickPatch(id,key,value){setLoading(true);try{await callGas('updateRentalFields',[id,{[key]:value}]);closeModal('detailModal');await refreshAll();toast('Đã cập nhật');if(key==='daNhanCocGiuLich'&&value){await copyRentalMessage(id,'depositReceived')}}catch(e){alert(e.message)}finally{setLoading(false)}}
async function copyRentalMessage(id,key){try{const msgs=await callGas('getRentalMessages',[id]);await copyText(msgs[key]);toast('Đã copy tin nhắn')}catch(e){alert(e.message)}}
async function copyTextFromDetail(key){if(!CURRENT_DETAIL)return;await copyRentalMessage(CURRENT_DETAIL.id,key)}
async function copyText(text){if(navigator.clipboard&&window.isSecureContext){try{await navigator.clipboard.writeText(text);return}catch(e){}}const t=document.createElement('textarea');t.value=text;document.body.appendChild(t);t.select();document.execCommand('copy');t.remove()}
function escapeHtml(v){return String(v??'').replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]))}

init();
</script>
</body>
</html>
